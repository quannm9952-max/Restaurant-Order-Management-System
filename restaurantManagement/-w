<!-- Figma frame: Table Management / Manager Available & Waiter Open Order -->
<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Table Management - Restaurant Order Management</title>
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Table Management - Restaurant Order Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet">
</head>
</head>
<body class="app-body">

<!-- Sidebar -->
<aside class="app-sidebar">
    <div class="sidebar-brand">
        <div class="brand-icon">
            <i class="bi bi-egg-fried"></i>
        </div>
        <div class="brand-text">
            <span class="brand-title">Restaurant</span>
            <span class="brand-subtitle">ORDER MANAGEMENT</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-group-label">WORKSPACE</div>

        <!-- WAITER sidebar -->
        
            <!-- TODO: Dashboard page not yet implemented -->
            <a href="#" class="nav-item nav-disabled" onclick="return false;">
                <i class="bi bi-grid-3x3-gap nav-icon"></i>
                <span>Dashboard</span>
            </a>

            <a href="/tables" class="nav-item  active">
                <i class="bi bi-grid nav-icon"></i>
                <span>Table Management</span>
            </a>

            <a href="/orders" class="nav-item">
                <i class="bi bi-receipt nav-icon"></i>
                <span>Order Management</span>
            </a>

            <!-- TODO: Serving Management page not yet implemented -->
            <a href="#" class="nav-item nav-disabled" onclick="return false;">
                <i class="bi bi-bell nav-icon"></i>
                <span>Serving Management</span>
            </a>
        

        <!-- MANAGER sidebar -->
        

        <!-- Fallback sidebar (unknown role) -->
        
    </nav>

    <div class="sidebar-footer">
        <div class="signed-in">
            <div class="signed-in-left">
                <div class="signed-in-label">SIGNED IN AS</div>
                <div class="signed-in-role">Waiter</div>
            </div>
            <i class="bi bi-lock-fill signed-in-lock"></i>
        </div>
        <div class="workspace-caption">Restaurant employee workspace</div>
    </div>
</aside>

<div class="app-wrapper">
    <!-- Top bar -->
    <header class="app-topbar">
    <div class="topbar-left">
        <h1 class="page-title">Table Management</h1>
    </div>
    <div class="topbar-right">
        <div class="user-avatar">DA</div>
        <div class="user-info">
            <div class="user-name">DEMO Phục vụ A</div>
            <div class="user-role">Waiter</div>
        </div>
        <!-- TODO(auth): Logout button will be added when Auth module (TV1) is merged -->
    </div>
</header>

    <!-- Main content -->
    <main class="app-content">
        <!-- Flash messages -->
        <div class="flash-messages">
    
    
</div>

        <!-- Page header -->
        <div class="page-header">
            <div class="d-flex align-items-center gap-2">
                <div>
                    <h2 class="page-heading">Table Management</h2>
                    <p class="page-subheading">View table availability and manage dine-in service.</p>
                </div>
                <span class="badge badge-role">Waiter access</span>
            </div>
            <div class="page-header-right">
                <!-- Add Table button (MANAGER only) -->
                
            </div>
        </div>

        <!-- Filter tabs -->
        <div class="filter-tabs">
            <a href="/tables"
               class="filter-tab  active">
                All Tables
                <span class="tab-count">6</span>
            </a>
            <a href="/tables?status=AVAILABLE"
               class="filter-tab">
                <span class="tab-dot dot-available"></span>
                Available
                <span class="tab-count">3</span>
            </a>
            <a href="/tables?status=OCCUPIED"
               class="filter-tab">
                <span class="tab-dot dot-occupied"></span>
                Occupied
                <span class="tab-count">2</span>
            </a>
            <a href="/tables?status=OUT_OF_SERVICE"
               class="filter-tab">
                <span class="tab-dot dot-outofservice"></span>
                OutOfService
                <span class="tab-count">1</span>
            </a>
            <div class="filter-tabs-spacer"></div>
            <span class="table-total">
                <span>6</span> tables
            </span>
        </div>

        <!-- Content area: grid + detail panel -->
        <div class="tables-content">
            <!-- Table grid -->
            <div class="tables-grid-section">
                <div class="grid-section-header">
                    <h3 class="grid-section-title">Restaurant tables</h3>
                    <span class="grid-section-hint">Select a table to view details</span>
                </div>

                <div class="tables-grid">
                    <div class="table-card  selected" data-table-id="1">

                        <!-- Checkmark for selected -->
                        <div class="card-check">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div class="card-header">
                            <div class="card-title">DEMO Bàn 01</div>
                            <div class="card-icon icon-occupied">
                                <i class="bi bi-chair"></i>
                            </div>
                        </div>

                        <div class="card-body">
                            <span class="status-pill pill-occupied">Occupied</span>
                        </div>

                        <div class="card-footer">
                            
                                Open order · <strong>ORD-0001</strong>
                            
                            
                        </div>
                    </div>
                    <div class="table-card" data-table-id="2">

                        <!-- Checkmark for selected -->
                        

                        <div class="card-header">
                            <div class="card-title">DEMO Bàn 02</div>
                            <div class="card-icon icon-occupied">
                                <i class="bi bi-chair"></i>
                            </div>
                        </div>

                        <div class="card-body">
                            <span class="status-pill pill-occupied">Occupied</span>
                        </div>

                        <div class="card-footer">
                            
                                Open order · <strong>ORD-0002</strong>
                            
                            
                        </div>
                    </div>
                    <div class="table-card" data-table-id="3">

                        <!-- Checkmark for selected -->
                        

                        <div class="card-header">
                            <div class="card-title">DEMO Bàn 03</div>
                            <div class="card-icon icon-available">
                                <i class="bi bi-chair"></i>
                            </div>
                        </div>

                        <div class="card-body">
                            <span class="status-pill pill-available">Available</span>
                        </div>

                        <div class="card-footer">
                            
                            
                                No Open order
                            
                        </div>
                    </div>
                    <div class="table-card" data-table-id="4">

                        <!-- Checkmark for selected -->
                        

                        <div class="card-header">
                            <div class="card-title">DEMO Bàn 04</div>
                            <div class="card-icon icon-available">
                                <i class="bi bi-chair"></i>
                            </div>
                        </div>

                        <div class="card-body">
                            <span class="status-pill pill-available">Available</span>
                        </div>

                        <div class="card-footer">
                            
                            
                                No Open order
                            
                        </div>
                    </div>
                    <div class="table-card" data-table-id="5">

                        <!-- Checkmark for selected -->
                        

                        <div class="card-header">
                            <div class="card-title">DEMO Bàn 05</div>
                            <div class="card-icon icon-out_of_service">
                                <i class="bi bi-chair"></i>
                            </div>
                        </div>

                        <div class="card-body">
                            <span class="status-pill pill-out_of_service">OutOfService</span>
                        </div>

                        <div class="card-footer">
                            
                            
                                No Open order
                            
                        </div>
                    </div>
                    <div class="table-card" data-table-id="6">

                        <!-- Checkmark for selected -->
                        

                        <div class="card-header">
                            <div class="card-title">DEMO Bàn 06</div>
                            <div class="card-icon icon-available">
                                <i class="bi bi-chair"></i>
                            </div>
                        </div>

                        <div class="card-body">
                            <span class="status-pill pill-available">Available</span>
                        </div>

                        <div class="card-footer">
                            
                            
                                No Open order
                            
                        </div>
                    </div>
                </div>

                

                <!-- Footer note -->
                <div class="tables-footer-note">
                    <i class="bi bi-info-circle"></i>
                    Max. one Open order per table. Order creation sets Occupied; successful payment or valid cancellation sets Available.
                </div>
            </div>

            <!-- Detail panel (right side) -->
            <div class="detail-panel">
                <div class="detail-panel-header">
                    <span class="detail-label">TABLE DETAILS</span>
                    <div class="detail-title-row">
                        <h3 class="detail-title">DEMO Bàn 01</h3>
                        <span class="status-pill pill-occupied">Occupied</span>
                    </div>
                </div>

                <div class="detail-info">
                    <div class="detail-row">
                        <span class="detail-info-label">Seating capacity</span>
                        <span class="detail-info-value">4 seats</span>
                    </div>
                </div>

                <!-- ==================== MANAGER DETAIL PANEL ==================== -->
                

                <!-- ==================== WAITER DETAIL PANEL ==================== -->
                
                    <!-- Open order section -->
                    <div class="detail-section">
                        <div class="detail-section-label">
                            <i class="bi bi-receipt"></i>
                            Open order
                        </div>

                        
                            <!-- Open order card (gray background) -->
                            <div class="order-card">
                                <div class="order-card-left">
                                    <a href="/orders/1"
                                       class="order-card-code">ORD-0001</a>
                                </div>
                                <span class="status-pill pill-occupied pill-small">Open</span>
                            </div>

                            <!-- Restricted status warning -->
                            <div class="info-box info-box-warning">
                                <div class="info-box-title">
                                    <i class="bi bi-lock"></i>
                                    Status changes restricted
                                </div>
                                <div class="info-box-text">Available and OutOfService cannot be set while this order is Open.</div>
                            </div>

                            <!-- Open Order Management button -->
                            <a href="/orders/1"
                               class="btn btn-primary btn-orange w-100">
                                Open Order Management
                            </a>

                            <!-- Disabled Update Status -->
                            <button type="button"
                                    class="btn btn-disabled w-100 mt-2"
                                    disabled
                                    title="Available and OutOfService cannot be set while this order is Open."
                                    data-bs-toggle="tooltip">
                                Update Status
                            </button>
                        

                        
                    </div>

                    <!-- Action buttons for no-order case (Waiter) -->
                    

                    <div class="detail-note">
                        <i class="bi bi-info-circle me-1"></i>
                        Creating an order automatically sets this table to Occupied.
                    </div>
                
            </div>
        </div>

        <!-- ==================== ADD TABLE MODAL (MANAGER) ==================== -->
        <!-- TODO: đối chiếu frame Figma Add Table -->
        

        <!-- ==================== EDIT TABLE MODAL (MANAGER) ==================== -->
        <!-- Figma frame: Table Management / Edit Table -->
        
    </main>

    <!-- Footer -->
    <footer class="app-footer">
    <small>Restaurant Order Management System &copy; 2025</small>
</footer>
</div>

<script src="/js/app.js"></script>
<script>
    // Initialize Bootstrap tooltips
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function(el) {
            return new bootstrap.Tooltip(el);
        });
    });
</script>
</body>
</html>
